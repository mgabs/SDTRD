#!/usr/bin/env sh
set -eu

SDTRD_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

target="${1:-.}"
if [ "$target" = "init" ]; then
  target="${2:-.}"
fi

mkdir -p "$target/specs/features" "$target/specs/bug-reports" "$target/specs/living" "$target/specs/templates"
cp "$SDTRD_ROOT/specs/WORKFLOW.md" "$target/specs/WORKFLOW.md"
cp "$SDTRD_ROOT/templates/"*.md "$target/specs/templates/"
cp "$SDTRD_ROOT/templates/.pre-commit-config.yaml" "$target/specs/templates/.pre-commit-config.yaml"

if [ ! -f "$target/.pre-commit-config.yaml" ]; then
  cp "$SDTRD_ROOT/templates/.pre-commit-config.yaml" "$target/.pre-commit-config.yaml"
fi

if [ -f "$target/.gitignore" ]; then
  grep -qxF ".worktrees/" "$target/.gitignore" || printf "\n.worktrees/\n" >> "$target/.gitignore"
else
  printf ".worktrees/\n" > "$target/.gitignore"
fi

echo "SDTRD initialized in $target/specs/"
