#!/usr/bin/env sh
# sdtrd [init] [target-dir]: wire SDTRD into an existing OpenSpec project.
set -eu

MIN_OPENSPEC="1.15.0"

# version_ge A B: succeeds when dotted numeric version A >= B.
version_ge() {
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)" = "$2" ]
}

# set_schema_line: stdin -> stdout, forcing exactly one "schema: sdtrd" line.
set_schema_line() {
  awk '
    /^schema:/ { if (!done) print "schema: sdtrd"; done = 1; next }
    { print }
    END { if (!done) print "schema: sdtrd" }
  '
}

# put_file SRC DST: copy only when DST is absent or differs.
put_file() {
  if [ ! -f "$2" ] || ! cmp -s "$1" "$2"; then
    mkdir -p "$(dirname -- "$2")"
    cp "$1" "$2"
  fi
}

install_hook() {
  hook="$1"
  mkdir -p "$(dirname -- "$hook")"
  cat <<'EOF' > "$hook"
#!/bin/sh
# SDTRD Workflow Branch Protection Hook
branch="$(git branch --show-current 2>/dev/null || git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    echo "ERROR: Direct commits to '$branch' are forbidden by SDTRD workflow." >&2
    echo "Please checkout an isolated branch first:" >&2
    echo "  git checkout -b feat/<id>-<name>   (for features)" >&2
    echo "  git checkout -b fix/<slug>          (for bugfixes)" >&2
    echo "  git checkout -b chore/<slug>        (for chores/tooling)" >&2
    exit 1
fi

# SDTRD LGTM Directive Preemption Hook
if [ -d ".lgtm/reviews" ]; then
    directives="$(grep -rn "^#ref " .lgtm/reviews 2>/dev/null || true)"
    if [ -n "$directives" ]; then
        echo "ERROR: Unresolved LGTM review directives found in .lgtm/reviews/:" >&2
        echo "$directives" >&2
        echo "SDTRD Rule: Review directives preempt all forward work. Resolve and clear them before committing." >&2
        exit 1
    fi
fi

# SDTRD Gate & Lane Check (installed by sdtrd)
if [ -x "openspec/sdtrd/sdtrd-check" ]; then
    sh openspec/sdtrd/sdtrd-check || exit 1
fi
EOF
  chmod +x "$hook"
}

main() {
  root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
  target="${1:-.}"
  if [ "$target" = "init" ]; then
    target="${2:-.}"
  fi

  if [ ! -d "$target/openspec" ]; then
    echo "ERROR: $target/openspec not found. Run 'openspec init' first." >&2
    exit 1
  fi

  version="$(openspec --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)"
  if [ -z "$version" ] || ! version_ge "$version" "$MIN_OPENSPEC"; then
    echo "ERROR: OpenSpec >= $MIN_OPENSPEC is required on PATH (found: ${version:-none})." >&2
    exit 1
  fi

  (cd "$root/schemas/sdtrd" && find . -type f) | while IFS= read -r f; do
    put_file "$root/schemas/sdtrd/$f" "$target/openspec/schemas/sdtrd/$f"
  done

  config="$target/openspec/config.yaml"
  if [ -f "$config" ]; then
    prev="$(sed -n 's/^schema:[[:space:]]*//p' "$config" | head -n 1)"
    set_schema_line < "$config" > "$config.sdtrd.tmp"
  else
    prev=""
    set_schema_line < /dev/null > "$config.sdtrd.tmp"
  fi
  if [ -f "$config" ] && cmp -s "$config.sdtrd.tmp" "$config"; then
    rm "$config.sdtrd.tmp"
  else
    mv "$config.sdtrd.tmp" "$config"
  fi
  if [ -n "$prev" ] && [ "$prev" != "sdtrd" ]; then
    echo "Replaced previous schema '$prev' with 'sdtrd' in openspec/config.yaml"
  fi

  if [ ! -f "$target/.pre-commit-config.yaml" ]; then
    cp "$root/templates/.pre-commit-config.yaml" "$target/.pre-commit-config.yaml"
  fi
  put_file "$root/templates/sdtrd-ci.yml" "$target/.github/workflows/sdtrd-ci.yml"
  for m in "$root/templates/mutation/"*; do
    put_file "$m" "$target/openspec/sdtrd/mutation/$(basename -- "$m")"
  done
  put_file "$root/rules/AGENTS.md" "$target/openspec/sdtrd/AGENTS.md"
  put_file "$root/bin/sdtrd-check" "$target/openspec/sdtrd/sdtrd-check"

  if [ -f "$target/.gitignore" ]; then
    grep -qxF ".worktrees/" "$target/.gitignore" || printf "\n.worktrees/\n" >> "$target/.gitignore"
  else
    printf ".worktrees/\n" > "$target/.gitignore"
  fi

  if [ ! -d "$target/.git" ]; then
    echo "warning: $target is not a git repository; skipping git hook." >&2
  elif [ ! -f "$target/.git/hooks/pre-commit" ]; then
    install_hook "$target/.git/hooks/pre-commit"
  fi

  echo "SDTRD wired into $target/openspec/ (schema: sdtrd)"
}

[ -n "${SDTRD_SOURCE_ONLY:-}" ] || main "$@"
