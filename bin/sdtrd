#!/usr/bin/env sh
set -eu

SDTRD_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

target="${1:-.}"
if [ "$target" = "init" ]; then
  target="${2:-.}"
fi

mkdir -p "$target/specs/features" "$target/specs/bug-reports" "$target/specs/living" "$target/specs/archive" "$target/specs/templates"
cp "$SDTRD_ROOT/specs/WORKFLOW.md" "$target/specs/WORKFLOW.md"
cp "$SDTRD_ROOT/templates/"*.md "$target/specs/templates/"
cp "$SDTRD_ROOT/templates/.pre-commit-config.yaml" "$target/specs/templates/.pre-commit-config.yaml"
cp "$SDTRD_ROOT/templates/sdtrd-ci.yml" "$target/specs/templates/sdtrd-ci.yml"

if [ ! -f "$target/specs/ROADMAP.md" ]; then
  cp "$SDTRD_ROOT/templates/roadmap.md" "$target/specs/ROADMAP.md"
fi

if [ ! -f "$target/.pre-commit-config.yaml" ]; then
  cp "$SDTRD_ROOT/templates/.pre-commit-config.yaml" "$target/.pre-commit-config.yaml"
fi

if [ -f "$target/.gitignore" ]; then
  grep -qxF ".worktrees/" "$target/.gitignore" || printf "\n.worktrees/\n" >> "$target/.gitignore"
else
  printf ".worktrees/\n" > "$target/.gitignore"
fi

if [ -d "$target/.git" ] && [ ! -f "$target/.git/hooks/pre-commit" ]; then
  mkdir -p "$target/.git/hooks"
  cat <<'EOF' > "$target/.git/hooks/pre-commit"
#!/bin/sh
# SDTRD Workflow Branch Protection Hook
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    echo "ERROR: Direct commits to '$branch' are forbidden by SDTRD workflow." >&2
    echo "Please checkout an isolated branch first:" >&2
    echo "  git checkout -b feat/<id>-<name>   (for features)" >&2
    echo "  git checkout -b fix/<slug>          (for bugfixes)" >&2
    echo "  git checkout -b chore/<slug>        (for chores/tooling)" >&2
    exit 1
fi
EOF
  chmod +x "$target/.git/hooks/pre-commit"
fi

echo "SDTRD initialized in $target/specs/"
